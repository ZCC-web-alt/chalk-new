CHALK_WEB_ENV=development
CHALK_SESSION_SECRET=replace-with-a-long-random-local-secret
CHALK_SESSION_COOKIE=chalk_session
CHALK_SESSION_TTL_SECONDS=604800
CHALK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHALK_SECURE_COOKIES=false
# Optional data override. Unset uses this project's data/ directory.
# CHALK_WEB_DATA_DIR=C:/path/to/chalk-web-data
CHALK_MAX_UPLOAD_BYTES=52428800
CHALK_MAX_ANALYSIS_CHARS=200000

# Optional compatibility override for an external legacy Chalk source tree.
# Normal standalone use must leave this unset so the bundled ../src/chalk_app is used.
# CHALK_LEGACY_ROOT=C:/path/to/legacy/chalk

# DashScope deployment credentials must be injected into the server process.
# Do not store production keys in this file. For local development, the API settings
# page stores a user-scoped DashScope key outside Git; deployment uses environment
# variables or GitHub protected-environment secrets.
# DASHSCOPE_API_KEY=replace-with-dashscope-qwen-key
# Local persistent budget prices for qwen3.8-max. These are non-secret and may be
# uncommented in your ignored backend/.env file. Use your DashScope region's current
# official prices; process environment variables override these values.
# QWEN_INPUT_COST_PER_MILLION_CNY=12
# QWEN_OUTPUT_COST_PER_MILLION_CNY=36
# Science 125 literature-provider credentials can be saved through local API settings.
# Deployment credentials must remain server environment variables or protected secrets.
# SCIENCE125_CROSSREF_MAILTO=researcher@example.org
# SCIENCE125_OPENALEX_MAILTO=researcher@example.org
# SCIENCE125_NCBI_API_KEY=replace-with-ncbi-api-key
# SCIENCE125_NCBI_TOOL_EMAIL=researcher@example.org
# SCIENCE125_SEMANTIC_SCHOLAR_API_KEY=replace-with-semantic-scholar-key
# SCIENCE125_NASA_ADS_API_TOKEN=replace-with-nasa-ads-token
# MATERIALS_PROJECT_API_KEY=replace-with-materials-project-api-key

# Provider policy notes:
# - arXiv requests use the documented 3-second interval.
# - NCBI E-utilities use the documented anonymous/keyed request ceilings.
# - Semantic Scholar API-key traffic uses the documented 1 RPS safety floor.
# - Other providers remain header-driven with a conservative local floor until
#   their current official quota headers are observed.
# Dedicated generation is limited to S125-006, S125-043, and S125-054 until pilot review passes.
