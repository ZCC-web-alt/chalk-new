CHALK_WEB_ENV=development
CHALK_SESSION_SECRET=replace-with-a-long-random-local-secret
CHALK_SESSION_COOKIE=chalk_session
CHALK_SESSION_TTL_SECONDS=604800
CHALK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CHALK_SECURE_COOKIES=false
# Optional data override. Unset uses this project's data/ directory.
# CHALK_WEB_DATA_DIR=C:/path/to/chalk-web-data
CHALK_MAX_UPLOAD_BYTES=52428800
CHALK_MAX_ANALYSIS_CHARS=200000

# Optional compatibility override for an external legacy Chalk source tree.
# Normal standalone use must leave this unset so the bundled ../src/chalk_app is used.
# CHALK_LEGACY_ROOT=C:/path/to/legacy/chalk

# DashScope deployment credentials must be injected into the server process.
# Do not store them in this file; the real canary reads DASHSCOPE_API_KEY directly
# from the process environment or a GitHub protected-environment secret.
